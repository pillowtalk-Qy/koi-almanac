{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koi-almanac-contributions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://pillowtalk-qy.github.io"
  },
  "ratelimits": [
    {
      "name": "CONTRIBUTION_RATE_LIMIT",
      "namespace_id": "274031",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
